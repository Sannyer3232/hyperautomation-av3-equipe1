# Configurações Gerais de Ambiente
TZ=America/Manaus

# URLs e Portas de Simulação
WEB_PANEL_URL=http://localhost:8000/resources/01_SELECAO_FORNECEDORES/web/painel_fornecedores_fake.html
WEB_PANEL_LOCAL_PATH=./resources/01_SELECAO_FORNECEDORES/web/painel_fornecedores_fake.html

# Diretórios e Arquivos de Entrada (Resources)
RESOURCES_DIR=./resources/01_SELECAO_FORNECEDORES
PROPOSTAS_DIR=./resources/01_SELECAO_FORNECEDORES/propostas
CRITERIOS_PATH=./resources/01_SELECAO_FORNECEDORES/criterios_ranking.xlsx
MODELO_RANKING_PATH=./resources/01_SELECAO_FORNECEDORES/modelo_ranking.xlsx

# Diretórios de Saída e Logs
OUTPUT_DIR=./output
OUTPUT_RANKING_PATH=./output/ranking_final.xlsx
LOGS_DIR=./logs
LOG_LEVEL=INFO

# Modo de Execução do Trigger: 'diretorio' (varre pasta local) ou 'email' (monitora caixa postal)
TRIGGER_MODE=diretorio

# Configurações do Trigger por E-mail (IMAP / SMTP)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SSL=true

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

EMAIL_USER=rpa.suprimentos@empresa.com
EMAIL_PASSWORD=sua_senha_ou_app_password

EMAIL_SUBJECT_TRIGGER=[SELEÇÃO FORNECEDORES]
EMAIL_ATTACHMENTS_DIR=./output/email_anexos
EMAIL_POLL_INTERVAL=10
